# Copy to .env and edit. Lines starting with # are ignored.

# --- Required: admin password for the web UI (at least 10 characters) -----------------
# Either a plain password...
ADMIN_PASSWORD=change-me-to-something-long
# ...or an argon2id hash instead (generate with:
#   docker run --rm -it --entrypoint /opt/venv/bin/python ghcr.io/codemastervy/smb-share-manager:latest -c "import argon2,getpass;print(argon2.PasswordHasher().hash(getpass.getpass()))"
# and write every $ as $$ in this file).
# ADMIN_PASSWORD_HASH=

# --- Folders that can be browsed and shared (comma-separated, container paths) ---------
# Each one must also be mounted in docker-compose.yml at the same path.
VOLUMES=/mnt/files

# --- Web UI ----------------------------------------------------------------------------
WEB_PORT=8095
BIND_ADDR=0.0.0.0
# Host names you use to reach the UI (IP addresses and localhost always work).
# Example: ALLOWED_HOSTS=nuc,nuc.tailnet-name.ts.net
ALLOWED_HOSTS=
# Reverse proxies whose X-Forwarded-For/-Proto headers are trusted (default: none).
TRUSTED_PROXIES=
# auto = Secure cookie when the request is HTTPS; true/false to force.
COOKIE_SECURE=auto
MAX_UPLOAD_MB=4096

# --- SMB -------------------------------------------------------------------------------
SMB_PORT_445=445
SMB_PORT_139=139
SMB_BIND_ADDR=0.0.0.0
# Name shown to clients (1-15 letters, digits or -).
SMB_SERVER_NAME=NAS
# Optional allow-list of client networks; empty = everyone who can reach the port.
# Example: SMB_HOSTS_ALLOW=192.168.68.0/24,100.64.0.0/10
SMB_HOSTS_ALLOW=
ENABLE_NMBD=false

# --- Process user for the web app (your user on the host) --------------------------------
PUID=1000
PGID=1000

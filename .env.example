# Copy to .env and edit. Lines starting with # are ignored.

# --- Required: admin password for the web UI (at least 10 characters) -----------------
# Either a plain password...
ADMIN_PASSWORD=change-me-to-something-long
# ...or an argon2id hash instead (generate with:
#   docker run --rm -it --entrypoint /opt/venv/bin/python ghcr.io/codemastervy/smb-share-manager:latest -c "import argon2,getpass;print(argon2.PasswordHasher().hash(getpass.getpass()))"
# and write every $ as $$ in this file).
# ADMIN_PASSWORD_HASH=

# --- Folders that can be browsed and shared (comma-separated, container paths) ---------
# Each one must also be mounted in docker-compose.yml at the same path.
VOLUMES=/mnt/files

# --- Web UI ----------------------------------------------------------------------------
WEB_PORT=8095
BIND_ADDR=0.0.0.0
# Host names you use to reach the UI (IP addresses and localhost always work).
# Example: ALLOWED_HOSTS=nuc,nuc.tailnet-name.ts.net
ALLOWED_HOSTS=
# Reverse proxies whose X-Forwarded-For/-Proto headers are trusted (default: none).
TRUSTED_PROXIES=
# auto = Secure cookie when the request is HTTPS; true/false to force.
COOKIE_SECURE=auto
MAX_UPLOAD_MB=4096

# --- SMB -------------------------------------------------------------------------------
SMB_PORT_445=445
SMB_PORT_139=139
SMB_BIND_ADDR=0.0.0.0
# Name shown to clients (1-15 letters, digits or -).
SMB_SERVER_NAME=NAS
# Optional allow-list of client networks; empty = everyone who can reach the port.
# Example: SMB_HOSTS_ALLOW=192.168.68.0/24,100.64.0.0/10
SMB_HOSTS_ALLOW=
ENABLE_NMBD=false

# --- Process user for the web app (your user on the host) --------------------------------
PUID=1000
PGID=1000

# --- WebDAV access from outside (optional, off by default) -----------------------------
# Read README "WebDAV access from outside" and SECURITY.md first. To enable:
#   1. COMPOSE_PROFILES=dav
#   2. DAV_EXPOSED_SHARES = the share names to serve (nothing is served while empty)
#   3. mount each of those shares' folders into the smb-dav service in docker-compose.yml
#   4. tick "Remote access (WebDAV)" for each user who should get in (use 16+ characters
#      of random password for them: WebDAV is reachable from the internet)
# COMPOSE_PROFILES=dav
DAV_EXPOSED_SHARES=
# Host port and address. Your reverse proxy reaches http://<this host>:8094. Plain HTTP
# from anything that is not a trusted proxy is refused before a password is read.
DAV_PORT=8094
DAV_BIND_ADDR=0.0.0.0
# Proxies allowed to set X-Forwarded-For/-Proto (or CF-Connecting-IP) for WebDAV. Must
# include the address your reverse proxy connects from, e.g. Traefik's Docker network
# (192.168.0.0/18 on a default Pangolin host; narrower is better). Separate from
# TRUSTED_PROXIES above so the admin UI does not start trusting it; empty = use
# TRUSTED_PROXIES.
DAV_TRUSTED_PROXIES=
# x-forwarded-for (default) or cf-connecting-ip (only if the proxy always sets it).
DAV_REAL_IP_HEADER=x-forwarded-for
# Largest upload. Cloudflare's free plan stops request bodies at 100 MB whatever this is.
DAV_MAX_UPLOAD_MB=4096
# How long a verified password is remembered (seconds, 0-3600). Password changes, removal
# and losing remote access end it at once regardless.
DAV_AUTH_CACHE_S=300
# Dedicated uid of the WebDAV container. Must not be 0 or PUID.
DAV_UID=2999
# Optional ntfy topic for "user locked out" alerts (rate-limited). Empty = off.
NTFY_URL=
NTFY_TOKEN=

# --- Files portal (optional, off by default) ---------------------------------------------
# The exposed shares in a web browser at files.<domain>, behind Pangolin single sign-on.
# Read README "Files portal" first. To enable:
#   1. COMPOSE_PROFILES=portal (or dav,portal for both)
#   2. set the variables below, add the share-folder lines to smb-portal in compose
#   3. in the admin UI, give each person a sign-in e-mail and tick Remote access
#   4. start it (setup mode), run scripts/portal-spoof-test.sh, then set
#      PORTAL_HEADER_VERIFIED=true and `docker compose up -d` again
# Public host name(s) of the portal, no scheme: files.example.org
PORTAL_HOSTS=
# Shares shown in the portal. Defaults to DAV_EXPOSED_SHARES.
PORTAL_EXPOSED_SHARES=
PORTAL_PORT=8096
PORTAL_BIND_ADDR=0.0.0.0
# The proxy (Traefik/Pangolin) that adds Remote-Email. Required; narrowest range that works.
PORTAL_TRUSTED_PROXIES=
# Required. Random, 32+ characters (`openssl rand -hex 32`). Add it in Pangolin as the
# custom header  X-Portal-Proxy-Secret: <value>  on the files resource.
PORTAL_PROXY_SECRET=
# Header Pangolin puts the signed-in user's e-mail in.
PORTAL_IDENTITY_HEADER=remote-email
# Leave false until scripts/portal-spoof-test.sh passes against the live portal.
PORTAL_HEADER_VERIFIED=false
PORTAL_MAX_UPLOAD_MB=4096
# Uid of the portal container. Must not be 0, PUID or DAV_UID.
PORTAL_UID=2998
